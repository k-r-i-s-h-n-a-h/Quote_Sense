# Copy to backend/.env and fill in your real keys.
GEMINI_API_KEY="your_google_gemini_api_key"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
# Tatva PM API (server-side quote fetch for sync-mongodb-quotes + project_id)
TATVA_API_BASE="https://devopsapi.withtatva.ai"
# Preferred: PM service key for live ObjectId catalogs (sent as x-api-key)
TATVA_API_KEY=
# Legacy fallback: admin JWT as Authorization Bearer
# TATVA_ADMIN_TOKEN=
# Optional: cache TTL seconds for live catalog (default 3600)
# TATVA_CATALOG_CACHE_TTL=3600
# Tatva PM quotation-type ObjectIds (Essential / Mid-segment / Luxury)
TATVA_QUOTE_TYPE_ESSENTIAL_ID=
TATVA_QUOTE_TYPE_MID_SEGMENT_ID=
TATVA_QUOTE_TYPE_LUXURY_ID=
# Write market_moving_averages when a user-finalized quote (isFinalizeQuote) is applied.
# Compare sessions never write MA. false|0|no → freeze all MA writes.
# true|1|yes|on|unset → allow finalized-quote merges into moving averages
# MARKET_RATE_UPDATES_ENABLED=false
# Only apply finalized quotes on/after this date (YYYY-MM-DD). Empty = no gate.
# MA_FINALIZE_MIN_DATE=2026-08-14
# PDF extraction (default gemini-3.5-flash). Gemini 3.x omits temperature in the API config.
GEMINI_EXTRACT_MODEL="gemini-3.5-flash"
# S3 leftover overlay + S6 narrative + chat (default gemini-3.7-flash)
GEMINI_COMPARE_MODEL="gemini-3.7-flash"
# Optional: override space leftover or work leftover independently
# GEMINI_SPACE_MODEL="gemini-3.7-flash"
# GEMINI_WORK_MODEL="gemini-3.7-flash"
# Cache static extraction rules + taxonomy (faster 2nd/3rd PDF, lower input cost)
GEMINI_EXPLICIT_CACHE="true"
GEMINI_CACHE_TTL="3600s"
